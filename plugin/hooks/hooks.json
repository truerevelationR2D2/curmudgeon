{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py",
              "--via=py"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py",
              "--via=python"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py",
              "--via=python3"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_async.py",
              "--via=py"
            ],
            "timeout": 600,
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_async.py",
              "--via=python"
            ],
            "timeout": 600,
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop_async.py",
              "--via=python3"
            ],
            "timeout": 600,
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(curmudgeon:)?curmudgeon-(reviewer|verifier)$",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/check_contract.py",
              "--via=py"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check_contract.py",
              "--via=python"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check_contract.py",
              "--via=python3"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^(curmudgeon:)?curmudgeon-",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/record_cost.py",
              "--via=py"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/record_cost.py",
              "--via=python"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/record_cost.py",
              "--via=python3"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard_state.py",
              "--via=py"
            ],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard_state.py",
              "--via=python"
            ],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard_state.py",
              "--via=python3"
            ],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell|Monitor|LSP|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py",
              "--via=py"
            ],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py",
              "--via=python"
            ],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py",
              "--via=python3"
            ],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(curmudgeon:)?curmudgeon-",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scratch_dir.py",
              "--via=py"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scratch_dir.py",
              "--via=python"
            ],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scratch_dir.py",
              "--via=python3"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scan_on_write.py",
              "--via=py"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scan_on_write.py",
              "--via=python"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scan_on_write.py",
              "--via=python3"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|LSP|WebFetch|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py",
              "--via=py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py",
              "--via=python"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py",
              "--via=python3"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
