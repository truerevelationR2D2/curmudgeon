{
  "servers": {
    "lint": {
      "command": "npx",
      "args": ["-y", "@example/lint-mcp@0.9.2"],
      "env": {"LINT_TOKEN": "${env:LINT_TOKEN}", "LOG_LEVEL": "debug"}
    },
    "local-docker": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "--network", "none", "-v", "./docs:/docs:ro", "example/docs:2.0"]
    }
  }
}
